PORT=3001

# Yandex Managed Service for MySQL (MySQL 8.0)
# Вариант A — одной строкой:
DATABASE_URL=mysql://mello_user:password@rc1a-xxxxxxxx.mdb.yandexcloud.net:3306/mello
# Вариант B — отдельными переменными (если не задан DATABASE_URL):
# MYSQL_HOST=rc1a-xxxxxxxx.mdb.yandexcloud.net
# MYSQL_PORT=3306
# MYSQL_USER=mello_user
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=mello

# TLS до Yandex MySQL. Скачайте корневой сертификат:
#   curl -o ~/.mysql/root.crt https://storage.yandexcloud.net/cloud-certs/CA.pem
# и укажите путь к нему (для проверки цепочки сертификатов):
# MYSQL_SSL_CA_PATH=/home/user/.mysql/root.crt
# либо вставьте PEM целиком в MYSQL_SSL_CA (удобно для Cloud Functions).
# DB_SSL=false  # полностью отключить TLS (например, локальный MySQL)

# Размер пула соединений
# DB_POOL=5

# Перенос данных из старой PostgreSQL (используется только scripts/migrate-data.js)
# PG_URL=postgresql://mello_user:password@rc1b-xxxxxxxx.mdb.yandexcloud.net:6432/mello

JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://yourusername.github.io
